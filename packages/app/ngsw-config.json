{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/main.*.js",
          "/assets/map-style.json"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**",
          "/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif)",
          "/*.js"
        ]
      }
    },
    {
      "name": "fonts",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/*.(otf|ttf|woff|woff2)"
        ],
        "urls": [
          "https://fonts.googleapis.com/**",
          "https://fonts.gstatic.com/**"
        ]
      }
    }
  ],
  "appData": {
    "version": "6.0.2-a0e8913e",
    "buildDate": "2026-06-18",
    "changelog": "- Add Geodienste layers\n- Optimize address search map layer generation\n- Optimize street search results\n- Resource table clickable\n- Rename protocol to list view\n- Translation file cleanup / modularize\n- Language change on login/operation/help page\n- Show message number on readonly view\n- Prevent multi submit on journal, allow submit with return\n- Show current UI version & changelog\n- Diverse small bugfixes"
  }
}