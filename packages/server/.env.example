HOST=0.0.0.0
PORT=1338
NODE_ENV=development
LOG_LEVEL=info

# Database (defaults match docker-compose.yml)
DATABASE_HOST=localhost
DATABASE_PORT=55432
DATABASE_NAME=zskarte_next
DATABASE_MAINTENANCE_DB=postgres
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=supersecret123
DATABASE_SCHEMA=public
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
# Alternative to the discrete settings above
#DATABASE_URL=postgres://postgres:supersecret123@localhost:55432/zskarte_next

# Run pending drizzle migrations on boot
RUN_MIGRATIONS_ON_BOOT=true

# Auth (Better Auth)
BETTER_AUTH_SECRET=dev-only-secret-change-me-please-32ch
BETTER_AUTH_URL=http://localhost:1338

# Comma separated list of allowed browser origins
TRUSTED_ORIGINS=http://localhost:4300,http://localhost:1338

# Comma separated list of hosts `proxy.fetch` may forward to, `*.` matches subdomains.
# Defaults to the geo services the app uses; loopback/private targets stay blocked anyway.
PROXY_ALLOWED_HOSTS=*.geo.admin.ch,geodienste.ch,*.geodienste.ch

# Changeset signing
SIGN_KEY_TYPE=ed25519
SIGN_PRIVATE_KEY_PASSPHRASE=E1WaoyNCpnxI9kZL3jSkcn0i4jqiHm1VmZqyEQWFV4Y=
SKIP_EXTERNAL_IP=false

# File storage: local | azure
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=public/uploads
#STORAGE_AZURE_ACCOUNT=
#STORAGE_AZURE_ACCOUNT_KEY=
#STORAGE_AZURE_CONTAINER_NAME=
#STORAGE_AZURE_SERVICE_BASE_URL=

# Map layer generation
MAPLAYER_GENERATION_ENABLED=false

# Permission cache TTL (ms)
PERMISSION_CACHE_TTL_MS=60000
