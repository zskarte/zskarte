{
  "kind": "collectionType",
  "collectionName": "signing_keys",
  "info": {
    "singularName": "signing-key",
    "pluralName": "signing-keys",
    "displayName": "Signing Key"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "keyId": {
      "type": "uid",
      "required": true
    },
    "serverId": {
      "type": "string",
      "required": true
    },
    "validFrom": {
      "type": "datetime",
      "required": true
    },
    "validUntil": {
      "type": "datetime"
    },
    "keyType": {
      "type": "enumeration",
      "required": true,
      "default": "ed25519",
      "enum": [
        "rsa",
        "ed25519"
      ]
    },
    "privateKeyEncrypted": {
      "type": "text",
      "private": true
    },
    "publicKey": {
      "type": "text",
      "required": true
    }
  }
}
