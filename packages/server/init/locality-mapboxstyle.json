{
  "version": 8,
  "name": "locality",
  "sources": {
    "locality": {
      "type": "geojson",
      "data": "./locality.geojson"

    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "rgba(0,0,0,0)"
      }
    },
    {
      "id": "zip",
      "type": "line",
      "source": "locality",
      "minzoom": 8.5,
      "filter": ["all",
        ["has", "ZIP4"],
        ["==", null, ["get", "ZsMapSearchResult"]]
      ],
      "layout": {},
      "paint": {
        "line-color": "#0000ff",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          8, 0.25,
          12, 1,
          16, 2.5,
          22, 5
        ],
        "line-gap-width": 0,
        "line-opacity": 1
      }
    },
    {
      "id": "locality",
      "type": "line",
      "source": "locality",
      "minzoom": 8,
      "filter": ["all",
        ["has", "LOCALITYID"],
        ["==", null, ["get", "ZsMapSearchResult"]]
      ],
      "layout": {},
      "paint": {
        "line-color": "#000000",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          8, 0.5,
          12, 1.5,
          16, 4,
          22, 7
        ],
        "line-gap-width": 0,
        "line-opacity": 1
      }
    },
    {
      "id": "searchResult",
      "type": "line",
      "source": "locality",
      "minzoom": 4,
      "filter": ["get", "ZsMapSearchResult"],
      "layout": {},
      "paint": {
        "line-color": "#ae0000",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          0, 0.5, 
          8, 0.5,
          12, 2,
          16, 3,
          22, 6
        ],
        "line-gap-width": 0,
        "line-opacity": 1
      }
    }
  ]
}