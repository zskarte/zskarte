{
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "target": "ES2022",

    "strict": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "incremental": true,
    "resolveJsonModule": true,
    "noEmitOnError": true,
    "noImplicitThis": true,

    "composite": true,
    "declaration": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": ".",
    "esModuleInterop": true
  },
  "include": ["./"],
  "exclude": ["node_modules/", "dist/"]
}
